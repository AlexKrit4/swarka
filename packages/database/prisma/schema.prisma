generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN") // SUPER_ADMIN | ADMIN | VIEWER
  createdAt DateTime @default(now())
}

model SiteSettings {
  id              String   @id @default("singleton")
  companyName     String   @default("Swarka")
  phone           String   @default("+7 (495) 000-00-00")
  whatsapp        String?
  telegram        String?
  email           String?
  logoText        String?
  logoUrl         String?
  heroTitle       String   @default("Изготовление и установка навесов в Москве и МО")
  heroSubtitle    String?
  heroImageUrl    String?
  promoTitle      String?
  promoSubtitle   String?
  promoBadge      String?
  promoEnabled    Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?
  yandexMetrikaId String?
  whyUsJson       String?
  contentJson     String?
  privacyContent  String?  @db.Text
  address         String?
  workZone        String   @default("Москва и Московская область")
  updatedAt       DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  priceFrom   Int?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  tag         String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Review {
  id         String  @id @default(cuid())
  authorName String
  text       String
  rating     Int     @default(5)
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String
  serviceType String?
  comment     String?
  source      String?
  status      LeadStatus @default(NEW)
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model ChangeLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  entityType String
  entityId   String?
  action     String
  label      String
  beforeJson String?  @db.Text
  afterJson  String?  @db.Text
  createdAt  DateTime @default(now())
}

model SiteSnapshot {
  id           String   @id @default(cuid())
  label        String?
  userId       String?
  userEmail    String?
  snapshotJson String   @db.Text
  createdAt    DateTime @default(now())
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Visitor {
  id          String   @id
  ipHash      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  visitCount  Int      @default(1)

  visits SiteVisit[]

  @@index([ipHash])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

model SiteVisit {
  id          String   @id @default(cuid())
  visitorId   String
  path        String
  referer     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  userAgent   String?
  device      String?
  isBot       Boolean  @default(false)
  createdAt   DateTime @default(now())

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
  @@index([isBot, createdAt])
}

model HostingBalance {
  id                String    @id @default("singleton")
  balanceRub        Int       @default(0)
  dailyRateRub      Int       @default(22)
  manualSiteEnabled Boolean   @default(true)
  lastDailyChargeAt DateTime?
  updatedAt         DateTime  @updatedAt
}

enum HostingPaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
}

model HostingPayment {
  id              String               @id @default(cuid())
  amountRub       Int
  status          HostingPaymentStatus @default(PENDING)
  provider        String               @default("yookassa")
  externalId      String?              @unique
  createdByUserId String?
  createdByEmail  String?
  paidAt          DateTime?
  metadata        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum HostingLedgerType {
  PAYMENT
  DAILY_CHARGE
  MANUAL_ADJUSTMENT
}

model HostingLedger {
  id           String            @id @default(cuid())
  type         HostingLedgerType
  amountRub    Int
  balanceAfter Int
  description  String
  paymentId    String?
  userId       String?
  userEmail    String?
  createdAt    DateTime          @default(now())

  @@index([createdAt])
}
